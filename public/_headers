# Every rule that matches a path applies, in file order, and a header set by two
# rules is joined with a comma. So the general cache rule comes first, and each
# narrower rule after it detaches that Cache-Control ("! Cache-Control") before
# setting its own.

# HTML and everything else: short cache, revalidate so content edits show up quickly.
/*
  Cache-Control: public, max-age=300, must-revalidate

# Hashed build assets never change: cache them forever.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The plain-text catalog (edition and root copy): UTF-8, so curl shows "–" and "·".
/catalog.txt
  Content-Type: text/plain; charset=utf-8
/*/catalog.txt
  Content-Type: text/plain; charset=utf-8

# Site icons and the web app manifest: a day, so a new icon arrives by tomorrow.
/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400
/favicon-32.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/icon-192.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/icon-512.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
/site.webmanifest
  Content-Type: application/manifest+json
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Crawler files: an hour.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  ! Cache-Control
  Cache-Control: public, max-age=3600
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  ! Cache-Control
  Cache-Control: public, max-age=3600
