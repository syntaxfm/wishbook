---
/**
 * Dev-only design system showcase: every component with sample data, on real
 * catalog pages so the paper & print effects apply. Injected as a route only
 * by `astro dev` (see astro.config.mjs); never part of the production build.
 */
import type { ImageMetadata } from "astro";
import CatalogNumber from "../components/CatalogNumber.astro";
import DesignSystem from "../components/DesignSystem.astro";
import Folio from "../components/Folio.astro";
import Frame from "../components/Frame.astro";
import Img from "../components/Img.astro";
import ItemLetter from "../components/ItemLetter.astro";
import Kbd from "../components/Kbd.astro";
import NewBanner from "../components/NewBanner.astro";
import PhotoQuote from "../components/PhotoQuote.astro";
import PickedBy from "../components/PickedBy.astro";
import Placeholder from "../components/Placeholder.astro";
import Price from "../components/Price.astro";
import PrintFilters from "../components/PrintFilters.astro";
import ShopLine from "../components/ShopLine.astro";
import type { HostRef, ResolvedAsset } from "../components/types";
import { editionUrl } from "../lib/urls";
import airDuster from "./samples/air-duster.jpg";
import cjPhoto from "./samples/cj.jpg";
import earplugs from "./samples/earplugs.jpg";
import eReader from "./samples/e-reader.jpg";
import headphones from "./samples/headphones.jpg";
import powerMeter from "./samples/usb-power-meter.jpg";
import randyPhoto from "./samples/randy.jpg";
import scottPhoto from "./samples/scott.jpg";
import wesPhoto from "./samples/wes.jpg";

const image = (meta: ImageMetadata): ResolvedAsset => ({ kind: "image", meta });
const placeholder = (label: string, color: string): ResolvedAsset => ({
  kind: "placeholder",
  label,
  color,
  key: label,
});

const edition = 2026;
const videoUrl = "https://www.youtube.com/watch?v=sample";
const wes: HostRef = { name: "Wes", avatar: image(wesPhoto) };
const randy: HostRef = { name: "Randy", avatar: image(randyPhoto) };
const scott: HostRef = { name: "Scott", avatar: image(scottPhoto) };
const cj: HostRef = { name: "CJ", avatar: image(cjPhoto) };
const kaitlin: HostRef = { name: "Kaitlin", avatar: placeholder("Kaitlin", "#7b4b3a") };
const orderLines = ["Call any time 1-555-SYNTAXFM", "Dial any SYN number to watch it get picked"];

const roles = [
  ["Masthead", "masthead", "WishBook"],
  ["Display headline", "display", "Wes's Favorite Things"],
  ["Item name", "itemname", "Silicone USB-C cables"],
  ["Toy-page serif", "tru", "Tech & Smart Home"],
  ["Body", "", "Never tangle and survive kids. Every color, length, and speed."],
  ["Quote", "quote", '"They never tangle, they are absolutely the best."'],
  ["Kicker", "kicker", "We have all the best for"],
  ["Accent script", "script", "gifts"],
  ["Price", "price", "149.99"],
  ["Catalog number", "mono", "SYN 036:41"],
  ["Handwriting", "hand", "Want!! ← for Dad"],
] as const;

const palette = [
  ["--red", "Wish red"],
  ["--green", "Holly green"],
  ["--yellow", "Price yellow"],
  ["--gold1", "Gold light"],
  ["--gold2", "Gold dark"],
  ["--cream", "Cream paper"],
  ["--peach", "Peach"],
  ["--ink", "Warm ink"],
  ["--syntax", "Syntax yellow"],
] as const;
---

<!doctype html>
<html lang="en" data-edition={edition}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Design system · Syntax WishBook (dev)</title>
    <DesignSystem />
  </head>
  <body>
    <PrintFilters />

    <nav class="demo-nav" aria-label="Showcase sections">
      <b>Design system (dev only)</b>
      <a href="#type">Type &amp; palette</a>
      <a href="#items">Items &amp; prices</a>
      <a href="#photos">Photos, quotes &amp; badges</a>
    </nav>

    <!-- ============ TYPE + PALETTE ============ -->
    <div class="caption" id="type">
      <b>Type roles · palette</b>
      <span>Every role in its font, and the palette tokens</span>
    </div>
    <div class="spread">
      <article class="page left reveal">
        <div class="pg">
          <h2 class="display sc-h">Type Roles</h2>
          <dl class="roles">
            {roles.map(([name, cls, sample]) => (
              <>
                <dt class="kicker">{name}</dt>
                <dd class={cls || undefined}>{sample}</dd>
              </>
            ))}
          </dl>
          <p>
            Body copy with a <b>bold lead-in</b>, an inline price <Price confirmed={24.99} />, an
            estimate <Price estimate={49.99} />, and a shortcut: press <Kbd>⌘K</Kbd> to search.
          </p>
          <ShopLine lines={orderLines} position={0} />
          <Folio side="left" number={2} edition={edition} path="welcome" />
        </div>
      </article>

      <article class="page right reveal">
        <div class="pg">
          <h2 class="display sc-h">Palette</h2>
          <ul class="swatches">
            {palette.map(([token, name]) => (
              <li>
                <span class="chip" style={{ background: `var(${token})` }} />
                <span>
                  <b>{name}</b>
                  <br />
                  <code class="mono">{token}</code>
                </span>
              </li>
            ))}
          </ul>
          <h3 class="kicker sc-sub">Wood textures</h3>
          <div class="woods">
            <div class="wood warm">
              <span class="kicker">--wood-warm</span>
            </div>
            <div class="wood floor">
              <span class="kicker">--wood-floor</span>
            </div>
          </div>
          <h3 class="kicker sc-sub">Worn ink (cover)</h3>
          <p class="worn-demo price worn">1·555·SYNTAXFM</p>
          <ShopLine text="Dial any SYN number to watch it get picked" />
          <Folio side="right" number={3} edition={edition} path="shoppers" />
        </div>
      </article>
    </div>

    <!-- ============ ITEMS + PRICES ============ -->
    <div class="caption" id="items">
      <b>Grid page · prices</b>
      <span>Frames, item letters, quotes below photos, order lines, picked-by sticker, folio</span>
    </div>
    <div class="spread">
      <article class="page left reveal">
        <div class="pg">
          <div class="pagehead">
            <div class="display">Wes's Favorite Things</div>
            <PickedBy hosts={[wes]} />
          </div>
          <div class="cards">
            <div class="card">
              <Frame>
                <Img
                  asset={image(powerMeter)}
                  alt="USB power meter"
                  sizes="(min-width: 1000px) 260px, 45vw"
                />
                <ItemLetter letter="A" variant="photo" />
              </Frame>
              <PhotoQuote
                text="You buy sketchy cables from China like I do… are they any good, right?"
                by="Wes"
                avatar={wes.avatar}
              />
              <div class="item">
                <ItemLetter letter="A" />
                <span class="itemname">USB power meter</span> shows volts, amps and watts. Lightning
                adapter not included (we threw it out).
                <Price
                  variant="line"
                  confirmed={26.95}
                  timestamp="1:34"
                  videoUrl={videoUrl}
                  unit="Each"
                />
              </div>
            </div>
            <div class="card">
              <Frame tone="dark">
                <Img
                  asset={placeholder("IMG-P01 · Silicone USB-C cables", "#5a3626")}
                  alt="Silicone USB-C cables"
                />
                <ItemLetter letter="B" variant="photo" />
              </Frame>
              <PhotoQuote
                text="They never tangle, they are absolutely the best."
                by="Wes"
                avatar={wes.avatar}
                verify
              />
              <div class="item">
                <ItemLetter letter="B" />
                <span class="itemname">Silicone USB-C cables</span> never tangle and survive kids.
                Every color, length, and speed.
                <Price variant="line" confirmed={13.99} timestamp="0:36" unit="Each" />
              </div>
            </div>
            <div class="card">
              <Frame tone="dark">
                <Img asset={image(airDuster)} alt="Wolfbox MegaFlow" sizes="260px" />
                <ItemLetter letter="C" variant="photo" />
              </Frame>
              <div class="item">
                <ItemLetter letter="C" />
                <span class="itemname">Wolfbox MegaFlow duster.</span> Rechargeable, so you can
                retire the canned air.
                <Price
                  variant="line"
                  estimate={76.49}
                  timestamp="8:15"
                  videoUrl={videoUrl}
                  unit="Each"
                />
              </div>
            </div>
            <div class="card">
              <Frame>
                <Img asset={image(eReader)} alt="Xteink X4" sizes="260px" />
                <ItemLetter letter="D" variant="photo" />
              </Frame>
              <div class="item">
                <ItemLetter letter="D" />
                <span class="itemname">Custom firmware edition.</span> Once CJ finishes writing it.
                <Price variant="line" text="TBA" timestamp="1:02:34" unit="Someday" />
              </div>
            </div>
          </div>
          <ShopLine lines={orderLines} position={1} />
          <Folio side="left" number={4} />
        </div>
      </article>

      <article class="page right reveal">
        <div class="pg">
          <h2 class="display sc-h">Prices</h2>
          <ul class="dotlist">
            <li>
              Plain, confirmed<span class="dots"></span>
              <Price confirmed={29.99} />
            </li>
            <li>
              Plain, estimate<span class="dots"></span>
              <Price estimate={16.99} />
            </li>
            <li>
              Catalog number, linked<span class="dots"></span>
              <CatalogNumber timestamp="36:41" videoUrl={videoUrl} />
            </li>
            <li>
              Catalog number, no episode URL<span class="dots"></span>
              <CatalogNumber timestamp={3754} />
            </li>
          </ul>
          <div class="sc-row">
            <Price variant="box" confirmed={69} />
            <Price variant="box" confirmed={109.99} />
            <span class="savetop">
              <span class="s">No monthly fee</span>
              <Price variant="box" confirmed={29.99} />
            </span>
          </div>
          <div class="band-demo">
            <NewBanner />
            <Price variant="big" confirmed={149.99} />
            <Price variant="big" estimate={76.49} />
          </div>
          <div class="sc-row">
            <span class="circled">
              <svg viewBox="0 0 300 120" preserveAspectRatio="none" aria-hidden="true">
                <path d="M40 20 C 120 -10, 280 5, 285 55 C 290 105, 120 120, 40 100 C -10 85, 5 25, 70 12"></path>
              </svg>
              <span class="itemname">Leatherman Arc</span> <Price confirmed={249.95} />
            </span>
          </div>
          <div class="sc-row">
            <ItemLetter letter="A" />
            <ItemLetter letter="B" />
            <span class="friendly">
              <ItemLetter letter="C" />
              Lean On Me.
            </span>
          </div>
          <Folio side="right" number={5} />
        </div>
      </article>
    </div>

    <!-- ============ PHOTOS + QUOTES + BADGES ============ -->
    <div class="caption" id="photos">
      <b>Photos · quotes · badges</b>
      <span>Wood frames with quotes on the photo, NEW ribbon and oval, stickers, placeholders</span>
    </div>
    <div class="spread">
      <article class="page left reveal">
        <div class="pg">
          <div class="photos">
            <Frame tone="wood">
              <NewBanner variant="oval" />
              <Img asset={image(headphones)} alt="beyerdynamic DT 270 PRO" sizes="300px" />
              <ItemLetter letter="A" variant="photo" />
              <PhotoQuote
                placement="on"
                text="These are just so good for dialogue editing… for editing a podcast all day long, highly recommend."
                by="Randy"
                avatar={randy.avatar}
              />
            </Frame>
            <Frame tone="wood">
              <Img asset={image(earplugs)} alt="Alpine FlyFit earplugs" sizes="300px" />
              <ItemLetter letter="B" variant="photo" />
              <PhotoQuote
                placement="on"
                text="Some people like to raw dog it… I chose to raw dog it with some earplugs."
                by="Randy"
                avatar={randy.avatar}
              />
            </Frame>
          </div>
          <Folio side="left" number={6} />
        </div>
      </article>

      <article class="page right reveal">
        <div class="pg">
          <div class="pagehead">
            <div class="display">Badges</div>
            <PickedBy hosts={[scott, cj]} />
          </div>
          <div class="sc-row">
            <PickedBy hosts={[kaitlin]} />
            <NewBanner />
            <NewBanner variant="oval" class="static" />
          </div>
          <div class="sc-row">
            <span class="sticker static">Recommended for 8+ hours of dialogue editing.</span>
          </div>
          <PhotoQuote
            big
            text="It's got this like cheesy lighting on here… I absolutely love it."
            by="Wes"
            avatar={wes.avatar}
          />
          <PhotoQuote text="I have this and I didn't even know that." by="Wes, on the UV light" />
          <div class="twoup">
            <Frame class="sq">
              <Img
                asset={placeholder("IMG-F5 · watch on pine bough, LCD glowing", "#8a5a3a")}
                alt="Ollee watch on a pine bough"
              />
              <ItemLetter letter="A" variant="big" />
            </Frame>
            <div>
              <Placeholder label="IMG-M1 grouse peeking" color="#7a5634" round class="peek" />
            </div>
          </div>
          <p class="sc-note">
            <a href={editionUrl(edition)}>Back to the {edition} cover</a>
          </p>
          <ShopLine lines={orderLines} position={2} />
          <Folio side="right" number={7} edition={edition} path="favorites/wes" />
        </div>
      </article>
    </div>
    <div style="height:80px"></div>

    <script>
      // Reveal pages once as they scroll into view (adds .in, which triggers the
      // one-time pops and the marker draw).
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.08 },
      );
      for (const el of document.querySelectorAll(".reveal")) io.observe(el);
    </script>
  </body>
</html>

<style is:global>
  /* showcase chrome and the few layout rules the samples borrow */
  .demo-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #111;
    color: #ddd;
    font:
      12px/1.4 system-ui,
      sans-serif;
    padding: 8px 14px;
    display: flex;
    gap: 6px 14px;
    flex-wrap: wrap;
    align-items: center;
    border-bottom: 3px solid var(--syntax);
  }
  .demo-nav b {
    color: var(--syntax);
  }
  .demo-nav a {
    color: #ddd;
    text-decoration: none;
    border-bottom: 1px dotted #666;
  }
  .caption {
    max-width: 1240px;
    margin: 42px auto 10px;
    padding: 0 14px;
    color: #d8c9b0;
    font:
      13px/1.4 system-ui,
      sans-serif;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .caption b {
    color: var(--syntax);
    font-size: 14px;
  }
  .caption span {
    color: #9c8f7c;
  }
  .spread {
    container-type: inline-size;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 14px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  @media (max-width: 860px) {
    .spread {
      grid-template-columns: 1fr;
      gap: 26px;
      max-width: 620px;
    }
    .spread .page {
      min-height: calc(min(100cqi, 620px) * 1.303);
    }
  }

  .pagehead {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2cqi;
    margin-bottom: 2.5cqi;
  }
  .pagehead .display {
    color: var(--red);
    font-size: 7.4cqi;
    line-height: 1;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3cqi 4cqi;
  }
  .cards > * {
    min-width: 0;
  }
  .card .frame {
    aspect-ratio: 4/3;
    margin-bottom: 0.7em;
  }
  .card .item {
    font-size: 0.95em;
    margin: 0;
  }
  .friendly {
    font-family: var(--f-tru);
    font-weight: 700;
    color: var(--red);
    font-size: 5cqi;
    line-height: 1.05;
    margin: 1.4cqi 0 0.4cqi;
  }
  .photos {
    display: grid;
    grid-template-rows: 1.35fr 1fr;
    gap: 2.5cqi;
    width: 55%;
    height: 100%;
  }
  .photos .frame {
    border: 0.7cqi solid var(--green);
    height: 100%;
    min-height: 24cqi;
  }
  .twoup {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5cqi;
    margin-top: 3cqi;
  }
  .twoup .sq {
    aspect-ratio: 1/1;
  }
  .savetop {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }
  .savetop .s {
    background: var(--red);
    color: #fff;
    font-family: var(--f-kicker);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85em;
    padding: 0.1em 0.5em;
    letter-spacing: 0.04em;
  }

  .sc-h {
    color: var(--red);
    font-size: 7.4cqi;
    line-height: 1;
    margin: 0 0 2cqi;
  }
  .sc-sub {
    color: var(--green);
    margin: 3cqi 0 1cqi;
  }
  .sc-row {
    display: flex;
    flex-wrap: wrap;
    gap: 3cqi;
    align-items: center;
    margin: 3cqi 0;
  }
  .sc-note {
    font-size: 0.85em;
  }
  .roles {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5em 1.2em;
    align-items: baseline;
    margin: 0 0 1em;
  }
  .roles dt {
    color: var(--green);
    font-size: 0.8em;
  }
  .roles dd {
    margin: 0;
    font-size: 1.3em;
  }
  .roles dd.masthead {
    font-size: 2.4em;
    line-height: 1;
  }
  .swatches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1em;
    font-size: 0.85em;
  }
  .swatches li {
    display: flex;
    gap: 0.6em;
    align-items: center;
  }
  .chip {
    width: 2.6em;
    height: 2.6em;
    flex: none;
    border: 1px solid rgba(0, 0, 0, 0.25);
  }
  .woods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2cqi;
  }
  .wood {
    height: 18cqi;
    display: grid;
    place-items: end start;
    padding: 0.5em;
    color: #f6dfb8;
  }
  .wood.warm {
    background: var(--wood-warm) 0 0 / 640px 420px;
  }
  .wood.floor {
    background: var(--wood-floor) 0 0 / 520px 340px;
  }
  .worn-demo {
    font-size: 9cqi;
    color: var(--red);
    margin: 0;
  }
  .band-demo {
    position: relative;
    display: flex;
    gap: 4cqi;
    align-items: flex-end;
    padding: 3cqi;
    margin: 3cqi 0;
    background:
      radial-gradient(circle at 15% 25%, rgba(200, 30, 40, 0.55) 0 7%, transparent 8%),
      radial-gradient(ellipse at 50% 50%, #2c6b3c 0%, #123a20 85%);
  }
  .newoval.static,
  .sticker.static {
    position: static;
  }
  .peek {
    width: 18cqi;
    height: 18cqi;
    border: 0.6cqi solid var(--cream);
  }
  @container (max-width: 520px) {
    .cards,
    .twoup,
    .woods {
      grid-template-columns: 1fr;
    }
    .swatches {
      grid-template-columns: 1fr 1fr;
    }
    .photos {
      width: 100%;
    }
  }
</style>
