---
/**
 * The ⌘K / Ctrl+K search: a modal <dialog> with a combobox input and a
 * listbox of results from the embedded item index. src/scripts/search.ts
 * drives it; Enter opens the active result through the book engine.
 */
import type { BookContext } from "../lib/book";
import Mascot from "./Mascot.astro";

interface Props {
  ctx: BookContext;
}

const { ctx } = Astro.props;
const { search, mascots } = ctx.content.site;
const title = search.label ?? "";
// the puzzled grouse beside the no-results line
const mascot = mascots.search ? await ctx.art(mascots.search) : null;
---

<dialog class="search-dialog" data-search aria-labelledby="search-title">
  <div class="search-box" role="search">
    <label id="search-title" class="search-title kicker" for="search-input">
      {title}
    </label>
    <input
      id="search-input"
      type="text"
      role="combobox"
      autocomplete="off"
      spellcheck="false"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="search-results"
      placeholder={search.placeholder ?? undefined}
      data-search-input
    />
    <ul id="search-results" role="listbox" aria-labelledby="search-title" data-search-results></ul>
    <div class="search-none" data-search-none hidden>
      {mascot && <Mascot asset={mascot} class="search-mascot" sizes="72px" />}
      <p>{search.none ? ctx.plain(search.none) : ""}</p>
    </div>
    <p class="search-keys" aria-hidden="true">
      <span>
        <kbd>↑</kbd>
        <kbd>↓</kbd>
      </span>
      <span>
        <kbd>↵</kbd>
      </span>
      <span>
        <kbd>esc</kbd>
      </span>
    </p>
  </div>
</dialog>
