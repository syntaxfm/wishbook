---
/**
 * Renders a copy field inline: text with **bold** and *italic*, plus tokens.
 *   {page:slug}  linked cross-reference, "page 6 A"
 *   {syn:item}   that item's catalog number, linked to the episode moment
 *   {count}      number of gifts in the edition
 *   {catalog}    the plain-text catalog address
 * Use <CopyParas> for multi-paragraph fields.
 */
import CatalogNumber from "./CatalogNumber.astro";
import type { BookContext } from "../lib/book";
import { parseCopyRuns } from "../lib/copy";

interface Props {
  text: string | null | undefined;
  ctx: BookContext;
}

const { text, ctx } = Astro.props;
const runs = text ? parseCopyRuns(text) : [];
const videoUrl = ctx.content.site.episode.videoUrl;
---

{runs.map((run) => {
  const node =
    run.kind === "text" ? (
      run.text
    ) : run.kind === "page" ? (
      <a class="pref" href={ctx.href(run.slug)}>
        {ctx.book.ref(run.slug)}
      </a>
    ) : run.kind === "syn" ? (
      ctx.item(run.slug).timestamp ? (
        <CatalogNumber timestamp={ctx.item(run.slug).timestamp!} videoUrl={videoUrl} />
      ) : (
        <span class="mono">SYN ---:--</span>
      )
    ) : run.kind === "count" ? (
      String(ctx.count)
    ) : (
      ctx.catalogAddress
    );
  if (run.bold && run.italic)
    return (
      <b>
        <i>{node}</i>
      </b>
    );
  if (run.bold) return <b>{node}</b>;
  if (run.italic) return <i>{node}</i>;
  return node;
})}
