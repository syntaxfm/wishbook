---
/**
 * An item's purchase link, small and quieter than the price: one "Buy" link
 * (the item's `linkLabel` instead, when set). It is rel="sponsored" unless the
 * item says the link isn't an affiliate or store link (`affiliate: false`). It
 * opens in a new tab and has at least a 44px touch target without taking extra
 * room in the layout.
 *
 * An item without a buy link (none yet, or `noLink`: never sold online) shows
 * nothing: in the book its row keeps only the wish-list slot; elsewhere nothing
 * renders. `pnpm links` lists the items still missing one.
 *
 * Every template renders purchase links through this one component, so they
 * can move or change in one place.
 *
 * In the book (`wish`), the row is the item's whole purchase row: the link on
 * the left and, on the right, an empty slot (`data-wish-slot`) where the wish
 * list puts the "Circle it" toggle. The slot holds the row's height at build
 * time, so the page is the same height with or without JavaScript.
 */
import type { BookContext } from "../lib/book";
import type { Item } from "../lib/content";

interface Props {
  item: Item;
  ctx: BookContext;
  class?: string;
  /** Reserve the wish-list toggle's place at the end of the row. */
  wish?: boolean;
}

const { item, ctx, class: className, wish = false } = Astro.props;
const labels = ctx.content.site.links;
const label = item.linkLabel ?? labels.buy;
---

{(wish || item.buyLink) && (
  <div class:list={["links", className, { "has-wish": wish }]} data-links={item.id}>
    {item.buyLink && (
      <a
        class="buy"
        href={item.buyLink}
        target="_blank"
        rel={item.affiliate ? "noopener sponsored" : "noopener"}
        aria-label={`${label ?? ""} ${item.name} (opens in a new tab)`.trim()}
      >
        {label} <span aria-hidden="true">↗</span>
      </a>
    )}
    {wish && <span class="wish-slot" data-wish-slot={item.id}></span>}
  </div>
)}
