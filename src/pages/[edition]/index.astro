---
// The edition's cover: /2026/.
import type { GetStaticPaths } from "astro";
import BookPage from "../../layouts/BookPage.astro";
import { getEditions } from "../../lib/content";
import { paginate } from "../../lib/paginate";

export const getStaticPaths = (() =>
  getEditions().map((edition) => ({
    params: { edition: String(edition) },
  }))) satisfies GetStaticPaths;

const { edition } = Astro.params;
const cover = (await paginate(edition)).pages[0]!;
---

<BookPage edition={edition} slug={cover.slug} />
