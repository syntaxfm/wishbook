---
/**
 * Order form: a carbon-copy order blank that the wish list fills in
 * (data-order-* hooks), share and print buttons, and the affiliate disclosure.
 * The alphabetical index of every gift is its own page (Index.astro).
 *
 * Every item has a prerendered, hidden row (data-order-item) with its catalog
 * number, name, purchase links, and price; the wish list (src/scripts/
 * wishlist.ts) reveals the circled ones in the order they were circled and
 * fills in the total. Blank rows pad the form until it has a few lines. In the
 * fixed page box the rows are six lines tall and a longer list scrolls inside.
 *
 * Beside the mail-to-Santa box stands a grouse: while nothing is circled, the
 * site's empty-list pose (the marker) with the empty-list line
 * (data-order-empty); once the list has items, the page's mascot (the gift,
 * data-order-filled). Without JavaScript the empty state shows.
 */
import CatalogNumber from "../../components/CatalogNumber.astro";
import Copy from "../../components/Copy.astro";
import ItemLinks from "../../components/ItemLinks.astro";
import Mascot from "../../components/Mascot.astro";
import PageShell from "../../components/PageShell.astro";
import Price from "../../components/Price.astro";
import { editionUrl } from "../../lib/urls";
import type { TemplateProps } from "./types";

type Props = TemplateProps;
const { page, content, ctx, state } = Astro.props;
const { orderForm, links, wishList } = ctx.content.site;
const videoUrl = ctx.content.site.episode.videoUrl;
const rows = ctx.content.items.map((item) => ({ item, home: ctx.indexPageOf(item) }));
// Blank lines on the order form until the wish list fills them (as on the
// printed form).
const BLANK_ROWS = 6;
const { guarantee, mascots } = ctx.content.site;
// The grouse at the mail box: the site's empty-list pose (with the empty-list
// line) until something is circled, then the page's own mascot.
const emptyMascot = mascots.emptyList ? await ctx.art(mascots.emptyList) : null;
const giftMascot = content.mascot ? await ctx.art(content.mascot) : null;
---

<PageShell page={page} ctx={ctx} state={state} class="orderpage">
  <h2 class="display">{content.copy.headline ?? content.title}</h2>
  <div class="form" data-order-form data-share-path={editionUrl(ctx.edition, "wishlist")}>
    <div class="row head">
      <span>Cat. No.</span>
      <span>Item</span>
      <span>Qty</span>
      <span>Price</span>
    </div>
    <div class="rows" data-order-rows>
      {rows.map(({ item, home }) => (
        <div class="row item-row" data-order-item={item.id} hidden>
          <span>
            {item.timestamp && <CatalogNumber timestamp={item.timestamp} videoUrl={videoUrl} />}
          </span>
          <span class="item-cell">
            {home ? <a href={ctx.href(home.slug)}>{item.name}</a> : <span>{item.name}</span>}
            <ItemLinks item={item} ctx={ctx} class="formlinks" />
          </span>
          <span>1</span>
          <span>
            <Price
              confirmed={item.price.confirmed}
              estimate={item.price.estimate}
              text={item.price.label ?? "–"}
            />
          </span>
        </div>
      ))}
      {Array.from({ length: BLANK_ROWS }, () => (
        <div class="row" data-order-row>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>
      ))}
    </div>
    <div class="row">
      <span></span>
      <span class="kicker">Total</span>
      <span></span>
      <span class="total" data-order-total></span>
    </div>
    <div class="carbon" aria-hidden="true"></div>
  </div>
  {wishList.unpriced && (
    <p class="smallprint" data-order-unpriced hidden>
      <Copy text={wishList.unpriced} ctx={ctx} />
    </p>
  )}
  {content.copy.smallprint && (
    <p class="smallprint">
      <Copy text={content.copy.smallprint} ctx={ctx} />
    </p>
  )}
  <div class="formbtns">
    {orderForm.shareLabel && (
      <button type="button" data-share>
        <Copy text={orderForm.shareLabel} ctx={ctx} />
      </button>
    )}
    {orderForm.printLabel && (
      <button type="button" class="alt" data-print>
        <Copy text={orderForm.printLabel} ctx={ctx} />
      </button>
    )}
  </div>
  <p class="sharemsg" role="status" data-share-status>
    <span data-share-copied hidden>
      {wishList.copied && <Copy text={wishList.copied} ctx={ctx} />}
    </span>
    <input
      class="shareurl"
      type="text"
      readonly
      aria-label={orderForm.shareLabel ? ctx.plain(orderForm.shareLabel) : undefined}
      data-share-url
      hidden
    />
  </p>
  <div class="mailrow">
    {emptyMascot && (
      <div class="mail-mascot is-empty" data-order-empty>
        <Mascot asset={emptyMascot} sizes="(min-width: 640px) 170px, 40vw" />
      </div>
    )}
    {giftMascot && (
      <div class="mail-mascot" data-order-filled hidden>
        <Mascot asset={giftMascot} sizes="(min-width: 640px) 110px, 26vw" />
      </div>
    )}
    {wishList.empty && (
      <p class="order-empty" data-order-empty>
        <Copy text={wishList.empty} ctx={ctx} />
      </p>
    )}
    {wishList.mailTo.length > 0 && (
      <div class="santa" aria-hidden="true">
        {wishList.mailTo.map((line) => (
          <div>{line}</div>
        ))}
      </div>
    )}
  </div>
  {links.disclosure && (
    <p class="disclosure">
      <Copy text={links.disclosure} ctx={ctx} />
    </p>
  )}
  {guarantee.text && (
    <div class="guarantee">
      {guarantee.lead && <b>{guarantee.lead}</b>} <span class="quote">{guarantee.text}</span>
    </div>
  )}
</PageShell>
