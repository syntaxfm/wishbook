---
/**
 * Grid page: photo cards in two columns, each with its letter, a host quote
 * below the photo, then the item copy and order line. A picked-by sticker
 * sits beside the headline.
 */
import Copy from "../../components/Copy.astro";
import Frame from "../../components/Frame.astro";
import Img from "../../components/Img.astro";
import ItemCopy from "../../components/ItemCopy.astro";
import ItemLetter from "../../components/ItemLetter.astro";
import ItemOrder from "../../components/ItemOrder.astro";
import ItemQuote from "../../components/ItemQuote.astro";
import NewBanner from "../../components/NewBanner.astro";
import PageShell from "../../components/PageShell.astro";
import PickedBy from "../../components/PickedBy.astro";
import { letterFor } from "./letters";
import type { TemplateProps } from "./types";

type Props = TemplateProps;
const { page, content, ctx, state } = Astro.props;
const pickers = await Promise.all(
  content.hosts.map(async (h) => ({ name: h.shortName, avatar: await ctx.avatar(h) })),
);
const cards = await Promise.all(
  content.items.map(async (pi, i) => ({
    ...pi,
    letter: letterFor(i),
    photo: await ctx.itemImage(pi.item, pi.photo),
    quote: !pi.text && !ctx.quotedElsewhere(pi.item, content) ? (pi.item.quotes[0] ?? null) : null,
  })),
);
---

<PageShell page={page} ctx={ctx} state={state} orderLine={ctx.orderLine(content.orderLine)}>
  <div class="pagehead">
    <h2 class="display">{content.copy.headline ?? content.title}</h2>
    {pickers.length > 0 && <PickedBy hosts={pickers} />}
  </div>
  {content.copy.kicker && (
    <div class="pagekicker kicker">
      <Copy text={content.copy.kicker} ctx={ctx} />
    </div>
  )}
  <div class="cards">
    {cards.map((card) => (
      <div class="card" data-item-id={card.item.id}>
        <Frame tone={card.item.image.background === "dark" ? "dark" : "light"}>
          <Img
            asset={card.photo}
            alt={card.item.image.alt}
            widths={[240, 320, 480, 640]}
            sizes="(min-width: 1000px) 260px, (min-width: 640px) 45vw, 90vw"
          />
          <ItemLetter letter={card.letter} variant="photo" />
          {card.item.isNew && !ctx.featuredElsewhere(card.item, content) && (
            <NewBanner variant="oval" />
          )}
          {card.badge && <span class="badge">{card.badge}</span>}
        </Frame>
        {card.quote && <ItemQuote quote={card.quote} ctx={ctx} />}
        {card.caption && (
          <p class="caption">
            <Copy text={card.caption} ctx={ctx} />
          </p>
        )}
        <div class="item">
          <ItemLetter letter={card.letter} />
          <ItemCopy item={card.item} ctx={ctx} text={card.text} />
          <ItemOrder item={card.item} ctx={ctx} page={content} />
        </div>
      </div>
    ))}
  </div>
</PageShell>
